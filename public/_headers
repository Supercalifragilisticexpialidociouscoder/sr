# Vite fingerprints these filenames, so a new build is a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted Plex. The filenames are stable, so they are renamed rather than
# edited if a face is ever replaced.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# The shell must not be cached, or a deploy leaves people on the old bundle.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
